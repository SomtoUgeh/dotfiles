#!/usr/bin/env bash
# Warn (never block) after a pull/merge brings in new content.
set -u
[ -x "$HOME/bin/scan-repo.sh" ] || exit 0
if ! "$HOME/bin/scan-repo.sh" "$(git rev-parse --show-toplevel)" >/tmp/.wormguard.$$ 2>&1; then
  printf '\033[1;33m\n[worm-guard] indicators found after merge — review before building:\033[0m\n' >&2
  cat /tmp/.wormguard.$$ >&2
fi
rm -f /tmp/.wormguard.$$
repo_hook="$(git rev-parse --git-dir)/hooks/post-merge"
[ -x "$repo_hook" ] && exec "$repo_hook" "$@"
exit 0
