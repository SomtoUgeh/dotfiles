#!/usr/bin/env bash
#
# Global pre-commit guard against the git config injection worm.
# Installed via: git config --global core.hooksPath ~/.git-hooks
#
# Scans STAGED content (git show :file), not the working tree — the worm
# appends to files after they are read, and the two can differ.
#
# Bypass:  git commit --no-verify        (or WORMGUARD_SKIP=1 git commit)
# Chains:  runs $GIT_DIR/hooks/pre-commit afterwards if one exists, because
#          a global core.hooksPath otherwise disables per-repo hooks silently.

set -u
[ "${WORMGUARD_SKIP:-0}" = "1" ] && exit 0

red() { printf '\033[0;31m%s\033[0m\n' "$1" >&2; }
ylw() { printf '\033[1;33m%s\033[0m\n' "$1" >&2; }

bad=0
note() { red "  [$1] $2"; bad=1; }
# Non-blocking. A very long line is a padding-independent payload signal: the
# real config upstream is 2.5 KB, the infected one carried a 34,696-char line.
warn() { ylw "  [$1] $2"; }

# IOC fragments, joined at use. Spelling an indicator out in full here makes
# other people's scanners report this guard as a hit. Detection is unchanged.
_t="temp_"; _b="branch_"
# v1 / v2 obfuscator signatures, split at a quote boundary so a -F search for
# the literal does not match this file. Joined values are byte-identical.
_s1="rmcej"'%otb%'; _s2="Cot"'%3t=shtP'
# Malicious npm package names, also fragmented for the same reason.
_tw="tailwindcss-"; _tl="tailwind-"; _pc="postcss-minify-"

# Only staged adds/copies/modifies.
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

while IFS= read -r f; do
  [ -z "$f" ] && continue
  content=$(git show ":$f" 2>/dev/null) || continue

  # Skip the guard's own files: a detector necessarily contains the strings it
  # detects. Any file may opt out with the marker below, used sparingly.
  case "$f" in
    git/hooks/*|*/git/hooks/*) continue ;;
  esac
  printf '%s' "$content" | grep -q 'worm-guard:allow-signatures' && continue

  case "$f" in
    *.js|*.cjs|*.mjs|*.mts|*.cts|*.ts|*.tsx|*.jsx|*.vue|*.svelte|*.astro|*.php|*.json|*.jsonc|*.sh|*.zsh|*.bash|*.py|*.rb|*.yml|*.yaml|*.toml|*.lock)
      printf '%s' "$content" | grep -vE '^[[:space:]]*(#|//|\*|/\*)' | grep -qE '[[:space:]]{50,}[^[:space:]]' \
        && note "padding" "$f — payload hidden after 50+ whitespace chars (space OR tab)"

      case "$f" in
        *.min.*|*-lock.json|package-lock.json|yarn.lock|pnpm-lock.yaml|*.bundle.*|*.map) ;;
        *) printf '%s' "$content" | awk 'length($0)>2000{exit 1}' \
             || warn "long-line" "$f — line over 2000 chars; scroll right before trusting it" ;;
      esac
      printf '%s' "$content" | grep -qE "global\[['\"](!|_V|_t_t|r|m)['\"]\]|global\.i[[:space:]]*=|global\.r[[:space:]]*=[[:space:]]*require|A8-3997-1|A8-5657-1|${_s1}|${_s2}|_\\\$_1e42" \
        && note "marker" "$f — worm bootstrap / campaign marker"
      printf '%s' "$content" | grep -qE 'require\([^)]*\\u00[0-9a-fA-F]{2}' \
        && note "escaped-require" "$f — Unicode-escaped require()"

      # Dependency names are plaintext, so this is cheap and worth blocking early.
      case "$f" in
        *package.json|*package-lock.json|*yarn.lock|*pnpm-lock.yaml)
          printf '%s' "$content" | grep -qE "${_tw}(style-animate|typography-style|style-modify|animate-style)|${_tl}(mainanimation|autoanimation|animationbased)|${_pc}selector-parser|html-to-gutenberg|fetch-page-assets|aes-decode-runner-pro" \
            && note "bad-dep" "$f — known malicious npm package" ;;
      esac
      ;;
  esac

  printf '%s' "$content" | grep -qE 'trongrid\.io|bsc-dataseed|166\.88\.54\.158' \
    && note "c2" "$f — known C2 endpoint"

  case "$f" in
    *.vscode/tasks.json|.vscode/tasks.json)
      printf '%s' "$content" | grep -q 'folderOpen' \
        && note "dropper" "$f — task runs on folderOpen" ;;
    *.vscode/settings.json|.vscode/settings.json)
      printf '%s' "$content" | grep -qE 'allowAutomaticTasks"[[:space:]]*:[[:space:]]*true' \
        && note "dropper" "$f — re-enables automatic tasks" ;;
    *.gitignore|.gitignore)
      # Fragments, not literals — see the same note in scripts/scan_repo.sh.
      printf '%s' "$content" | grep -qE "${_t}auto_push\.bat|${_t}interactive_push\.bat|${_b}structure\.json" \
        && note "artifacts" "$f — worm .gitignore entries" ;;
    *.bat|*.ps1)
      # Name-match only the two known scripts; a legitimate settings.ps1 exists.
      case "$f" in
        *${_t}auto_push.bat|*${_t}interactive_push.bat) note "dropper" "$f — worm push script" ;;
      esac
      printf '%s' "$content" | grep -q 'LAST_COMMIT_DATE' \
        && note "dropper" "$f — commit-tamper script signature" ;;
    *.woff2)
      [ "$(git show ":$f" 2>/dev/null | head -c 4)" = "wOF2" ] \
        || note "fake-font" "$f — .woff2 without wOF2 magic bytes" ;;
    *.woff)
      [ "$(git show ":$f" 2>/dev/null | head -c 4)" = "wOFF" ] \
        || note "fake-font" "$f — .woff without wOFF magic bytes" ;;
  esac
done <<< "$files"

if [ "$bad" -ne 0 ]; then
  red ""
  red "COMMIT BLOCKED — worm indicators in staged content."
  ylw "If you are certain this is legitimate:  git commit --no-verify"
  exit 1
fi

# Chain to the repository's own hook, which a global hooksPath would bypass.
repo_hook="$(git rev-parse --git-dir)/hooks/pre-commit"
[ -x "$repo_hook" ] && exec "$repo_hook" "$@"
exit 0
