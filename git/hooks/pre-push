#!/usr/bin/env bash
# worm-guard:allow-signatures
#
# Global pre-push guard against the git config injection worm.
# Installed via: git config --global core.hooksPath ~/.git-hooks
#
# Companion to pre-commit. pre-commit catches what YOU author; pre-push catches
# what you PULLED from someone else and are about to forward to a remote.
# Reads blobs at the PUSHED sha, not the working tree — the two can differ.
#
# Bypass:  git push --no-verify        (or WORMGUARD_SKIP=1 git push)
# Chains:  runs $GIT_DIR/hooks/pre-push afterwards if one exists, because
#          a global core.hooksPath otherwise disables per-repo hooks silently.
#
# NOTE: the worm passes --no-verify, so this cannot stop it. It is a tripwire
#       that tells you the tree is already dirty, not a control.
#
# diff-tree needs --root or a root commit reports NO changed files and the
# check silently passes. Verified against a known-infected sample.

set -u
[ "${WORMGUARD_SKIP:-0}" = "1" ] && exit 0

red() { printf '\033[0;31m%s\033[0m\n' "$1" >&2; }
ylw() { printf '\033[1;33m%s\033[0m\n' "$1" >&2; }

bad=0
note() { red "  [$1] $2"; bad=1; }
# Non-blocking. A very long line is a padding-independent payload signal: the
# real config upstream is 2.5 KB, the infected one carried a 34,696-char line.
warn() { ylw "  [$1] $2"; }


# IOC fragments, joined at use — see the same note in pre-commit.
_t="temp_"; _b="branch_"

zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
remote_name="${1:-origin}"

# Emit "<pushed-sha>\t<path>" for every file added or modified by the commits
# heading to the remote. Runs in a pipeline, so it consumes the hook's stdin.
pairs=$(while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue            # branch deletion
  if [ "${remote_sha:-$zero}" = "$zero" ]; then     # new branch on the remote
    new=$(git rev-list "$local_sha" --not --remotes="$remote_name" 2>/dev/null)
  else
    new=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null)
  fi
  for c in $new; do
    git diff-tree -r --root --no-commit-id --name-only --diff-filter=ACM "$c" 2>/dev/null \
      | sed "s|^|$local_sha	|"
  done
done | sort -u)

[ -z "$pairs" ] && exit 0

while IFS=$'\t' read -r tip f; do
  [ -z "${f:-}" ] && continue
  case "$f" in
    git/hooks/*|*/git/hooks/*) continue ;;
  esac

  # Classify first. Specific paths must precede the generic extension list, and
  # anything unclassified is skipped WITHOUT reading the blob — that keeps
  # binaries out of a command substitution (bash drops null bytes and warns)
  # and cuts a full-history scan from ~14s to well under a second.
  kind=""
  case "$f" in
    .vscode/tasks.json|*/.vscode/tasks.json)       kind=tasks ;;
    .vscode/settings.json|*/.vscode/settings.json) kind=vsettings ;;
    .gitignore|*/.gitignore)                       kind=ignore ;;
    *.woff2)                                       kind=woff2 ;;
    *.woff)                                        kind=woff ;;
    *.bat)                                         kind=bat ;;
    *.js|*.cjs|*.mjs|*.mts|*.cts|*.ts|*.tsx|*.jsx|*.vue|*.svelte|*.astro|*.php|*.json|*.jsonc|*.sh|*.zsh|*.bash|*.py|*.rb|*.yml|*.yaml|*.toml)
                                                   kind=code ;;
    *) continue ;;
  esac

  # Fonts are checked by magic bytes only — never read whole.
  case "$kind" in
    woff2)
      [ "$(git cat-file blob "$tip:$f" 2>/dev/null | head -c 4)" = "wOF2" ] \
        || note "fake-font" "$f — .woff2 without wOF2 magic bytes"
      continue ;;
    woff)
      [ "$(git cat-file blob "$tip:$f" 2>/dev/null | head -c 4)" = "wOFF" ] \
        || note "fake-font" "$f — .woff without wOFF magic bytes"
      continue ;;
  esac

  content=$(git show "$tip:$f" 2>/dev/null) || continue
  printf '%s' "$content" | grep -q 'worm-guard:allow-signatures' && continue

  printf '%s' "$content" | grep -qE 'trongrid\.io|bsc-dataseed|166\.88\.54\.158' \
    && note "c2" "$f — known C2 endpoint"

  case "$kind" in
    code)
      printf '%s' "$content" | grep -vE '^[[:space:]]*(#|//|\*|/\*)' | grep -qE '[[:space:]]{50,}[^[:space:]]' \
        && note "padding" "$f — payload hidden after 50+ whitespace chars (space OR tab)"
      printf '%s' "$content" | grep -qE "global\[['\"](!|_V|_t_t)['\"]\]|global\.i[[:space:]]*=|global\.r[[:space:]]*=[[:space:]]*require|A8-3997-1" \
        && note "marker" "$f — worm bootstrap / campaign marker"
      printf '%s' "$content" | grep -qE 'require\([^)]*\\u00[0-9a-fA-F]{2}' \
        && note "escaped-require" "$f — Unicode-escaped require()"

      case "$f" in
        *.min.*|*-lock.json|package-lock.json|yarn.lock|pnpm-lock.yaml|*.bundle.*|*.map) ;;
        *) printf '%s' "$content" | awk 'length($0)>2000{exit 1}' \
             || warn "long-line" "$f — line over 2000 chars; scroll right before trusting it" ;;
      esac
      ;;
    tasks)
      printf '%s' "$content" | grep -q 'folderOpen' \
        && note "dropper" "$f — task runs on folderOpen" ;;
    vsettings)
      printf '%s' "$content" | grep -qE 'allowAutomaticTasks"[[:space:]]*:[[:space:]]*true' \
        && note "dropper" "$f — re-enables automatic tasks" ;;
    ignore)
      printf '%s' "$content" | grep -qE "${_t}auto_push\.bat|${_t}interactive_push\.bat|${_b}structure\.json" \
        && note "artifacts" "$f — worm .gitignore entries" ;;
    bat)
      case "$f" in
        *${_t}auto_push.bat|*${_t}interactive_push.bat) note "dropper" "$f — worm push script" ;;
      esac
      printf '%s' "$content" | grep -q 'LAST_COMMIT_DATE' \
        && note "dropper" "$f — commit-tamper script signature" ;;
  esac
done <<< "$pairs"

if [ "$bad" -ne 0 ]; then
  red ""
  red "PUSH BLOCKED — worm indicators in commits being pushed."
  ylw "Do NOT use --no-verify. If you did not write that code, treat this machine as compromised."
  exit 1
fi

repo_hook="$(git rev-parse --git-dir)/hooks/pre-push"
[ -x "$repo_hook" ] && exec "$repo_hook" "$@"
exit 0
