# erivault: the Erivault app and website.
NAME=erivault
BOAT_ENV=erivault
TYPE=large
REPOS=(
  "code/erivault/erivault_app|git@github.com:Fair-Let-Inventory/erivault_app.git|pnpm install --frozen-lockfile"
  "code/erivault/erivault_website|git@github.com:Fair-Let-Inventory/erivault_website.git|bun install"
)
CHECK_ENV=erivault
