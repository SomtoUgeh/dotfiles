# icb: Ibadan City Bus (fares backend, back office, Kotlin bus-reader app).
# One line per repo: "<path under ~>|<git url>|<install command, run once after the first clone>"
NAME=icb
BOAT_ENV=icb
TYPE=large
REPOS=(
  "code/personal/icb|git@github.com:SomtoUgeh/icb.git|pnpm install --frozen-lockfile"
)
CHECK_ENV=icb
BUN_VERSION=1.4.4
# Extra lines for ~/.zshenv.local (read by every zsh, so agents and T3 device tools see them).
ZSHENV_LOCAL='export JAVA_HOME=/opt/jdk25 ANDROID_HOME=$HOME/Android/Sdk
export PATH=$JAVA_HOME/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$ANDROID_HOME/cmdline-tools/latest/bin:$PATH'
