#!/usr/bin/env bash
# vm-heal: put a boat project VM back together after a resume. Runs as `user`.
#
# Why (18 Nov 2026): on resume boat boots the machine from its base image, then restores the
# saved disk lazily (ascii-agents-server "[restore] ... lazyfs staging"). systemd has already
# read its units by then, so our enabled units (tailscaled, <p>-keepalive.timer,
# boat-idle-stop.timer, vm-setup-sync.timer) never start. On erivault the restore even came
# back with the base image's /etc, /usr and /var (Tailscale uninstalled, its node key gone,
# our timers gone) while /home/user was intact. This script lives in /home, which always
# survives, keeps a copy of our system files there, and puts back whatever is missing.
#
# 21 Nov 2026: /home does not always survive either. coworkers, erivault and investor-os came back
# without ~/.gitconfig, the per-VM GitHub key, gh login, T3's unit and runtime state, half of this
# folder, /etc/group and gshadow, ubuntu.sources and zsh, and repos without .git/HEAD. So this
# script now also keeps: a root-owned mirror of this folder in /var/lib/vm-heal-mirror, the group
# files, the first SSH host keys (a fresh boot makes new ones and the Mac then refuses the VM with
# "Host key verification failed"), and a bundle of the home files above. Damaged repos are logged.
#
# Triggers (all safe to overlap, a lock keeps one run at a time):
#   ~/.config/autostart/vm-heal.desktop   boat restarts the desktop session after the restore
#   /etc/cron.d/vm-heal                   every minute; cron rescans cron.d, systemd does not
#   the Mac's `vm up` / julds-autowake    `boat ssh <id> -- .local/bin/vm-heal` after a resume
#
# Usage: vm-heal            one pass (quiet unless it changes something)
#        vm-heal --loop     one pass now, then every 5 min (autostart)
#        vm-heal --status   show what it checks
#        vm-heal --setup <project> <sandbox id>   first-time install on a VM
set -uo pipefail
D="$HOME/.local/share/vm-heal"; LOG="$HOME/.local/state/vm-heal.log"
mkdir -p "$D" "$(dirname "$LOG")"
export XDG_RUNTIME_DIR=/run/user/$(id -u) PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
S="sudo -n"
say() { echo "$(date -u +%FT%TZ) $*" >> "$LOG"; logger -t vm-heal "$*" 2>/dev/null; [ -t 1 ] && echo "$*"; }

if [ "${1:-}" = --setup ]; then
  printf 'P=%s\nBOAT_ID=%s\n' "${2:?project}" "${3:?sandbox id}" > "$D/conf"
  mkdir -p "$HOME/.config/autostart"
  cat > "$HOME/.config/autostart/vm-heal.desktop" <<A
[Desktop Entry]
Type=Application
Name=vm-heal
Comment=Put Tailscale, T3 and the VM timers back after a boat resume
Exec=$HOME/.local/bin/vm-heal --loop
X-GNOME-Autostart-enabled=true
NoDisplay=true
A
  echo "* * * * * user $HOME/.local/bin/vm-heal" | $S tee /etc/cron.d/vm-heal >/dev/null
  $S chmod 644 /etc/cron.d/vm-heal
  set -- ""
fi

# Fill anything missing in $D from the root-owned mirror (no overwrite).
M=/var/lib/vm-heal-mirror
if sudo -n test -d $M 2>/dev/null; then
  before=$(ls -A "$D" | wc -l)
  sudo -n cp -an $M/. "$D"/ 2>/dev/null && sudo -n chown -R "$(id -u):$(id -g)" "$D" 2>/dev/null
  [ "$(ls -A "$D" | wc -l)" -gt "$before" ] && say "put back missing files in $D from $M"
fi

[ -r "$D/conf" ] || { echo "vm-heal: not set up (vm-heal --setup <project> <sandbox id>)"; exit 0; }
. "$D/conf"

if [ "${1:-}" = --loop ]; then
  while :; do "$0"; sleep 300; done
fi

exec 9>/tmp/vm-heal.lock; flock -n 9 || exit 0

# 0. /etc/passwd itself can come back missing (investor-os, 18 Nov 2026 20:30): then sudo, cron jobs
# for `user` and boat ssh all fail. `user` is in the docker group, so put it back through docker.
if ! getent passwd "$(id -u)" >/dev/null 2>&1 && [ -s "$D/passwd" ]; then
  if docker run --rm -v /etc:/h -v "$D":/b:ro alpine sh -c 'cp /b/passwd /h/passwd && chown 0:0 /h/passwd && chmod 644 /h/passwd' >/dev/null 2>&1; then
    say "restored /etc/passwd from the copy in /home (it was missing)"
  else say "/etc/passwd is missing and the docker restore failed"; fi
fi
# 0b. /etc/group and /etc/gshadow came back missing on erivault (21 Nov 2026): apt then fails on
# packages with system-group overrides, so Tailscale could not be reinstalled.
if [ ! -s /etc/group ] && [ -s "$D/group" ]; then
  if $S install -m 644 -o 0 -g 0 "$D/group" /etc/group 2>/dev/null \
     || docker run --rm -v /etc:/h -v "$D":/b:ro alpine sh -c 'cp /b/group /h/group && chown 0:0 /h/group && chmod 644 /h/group' >/dev/null 2>&1; then
    say "restored /etc/group from the copy in /home (it was missing)"
  else say "/etc/group is missing and the restore failed"; fi
fi
if ! $S test -e /etc/gshadow && [ -s "$D/gshadow" ] && [ -s /etc/group ]; then
  $S install -m 640 -o 0 -g shadow "$D/gshadow" /etc/gshadow 2>/dev/null && say "restored /etc/gshadow from the copy in /home"
fi

# Files we own outside /home. Kept in $D/system.tgz while they are all present.
files() {
  local f
  for f in \
    /etc/systemd/system/$P-hostname.service \
    /etc/systemd/system/multi-user.target.wants/$P-hostname.service \
    /usr/local/sbin/$P-keepalive \
    /etc/systemd/system/$P-keepalive.service /etc/systemd/system/$P-keepalive.timer \
    /etc/systemd/system/timers.target.wants/$P-keepalive.timer \
    /usr/local/sbin/boat-idle-stop /usr/local/bin/vm-stay /etc/boat-idle.env \
    /etc/systemd/system/boat-idle-stop.service /etc/systemd/system/boat-idle-stop.timer \
    /etc/systemd/system/timers.target.wants/boat-idle-stop.timer \
    /etc/boat-check.env /etc/cron.d/vm-heal /var/lib/systemd/linger/user \
    /etc/apt/sources.list.d/tailscale.list /usr/share/keyrings/tailscale-archive-keyring.gpg \
    /etc/apt/sources.list.d/1password.list /usr/share/keyrings/1password-archive-keyring.gpg \
    /etc/apt/sources.list.d/ubuntu.sources \
    /etc/systemd/system/*.d/90-t3code-protect.conf; do
    [ -e "$f" ] || [ -L "$f" ] && echo "$f"
  done
}
WANT=(/usr/local/sbin/$P-keepalive /etc/systemd/system/$P-keepalive.timer /usr/local/sbin/boat-idle-stop
      /etc/systemd/system/boat-idle-stop.timer /etc/boat-idle.env /etc/systemd/system/$P-hostname.service
      /etc/cron.d/vm-heal /etc/apt/sources.list.d/ubuntu.sources)
# Home files a restore has lost (21 Nov 2026). Kept in $D/home.tgz; put back if a key one is missing.
home_files() {
  local f; cd "$HOME" || return
  for f in .gitconfig .gitconfig.local .gitconfig-personal .ssh/id_ed25519_* .ssh/allowed_signers .ssh/config \
    .ssh/authorized_keys .config/gh .config/systemd/user .config/executor-v2 .local/bin/t3 .local/bin/t3-service-launcher \
    .t3/runtime/service-state.json .t3/runtime/launchers .t3/userdata/environment-id .t3/userdata/anonymous-id \
    .t3/userdata/settings.json .t3/userdata/server-runtime.json .t3/userdata/secrets; do
    [ -e "$f" ] || [ -L "$f" ] && echo "$f"
  done
}
HOME_WANT=(.gitconfig .config/systemd/user/t3code.service .t3/userdata/environment-id .t3/runtime/service-state.json)

if [ "${1:-}" = --status ]; then
  echo "project $P, sandbox $BOAT_ID, host $(hostname)"
  for f in "${WANT[@]}"; do printf '%-50s %s\n' "$f" "$([ -e "$f" ] && echo ok || echo MISSING)"; done
  for u in tailscaled $P-keepalive.timer boat-idle-stop.timer; do printf '%-50s %s\n' "$u" "$(systemctl is-active $u)"; done
  printf '%-50s %s\n' "t3code (user)" "$(systemctl --user is-active t3code.service)"
  printf '%-50s %s\n' "tailscale" "$(tailscale status --self --peers=false 2>&1 | head -1)"
  printf '%-50s %s\n' "backup" "$(ls -l --time-style=+%F\ %R "$D/system.tgz" 2>/dev/null | awk '{print $6, $7}')"
  for f in group gshadow sshhost.tgz home.tgz; do printf '%-50s %s\n' "copy: $f" "$([ -s "$D/$f" ] && echo ok || echo MISSING)"; done
  for f in "${HOME_WANT[@]}"; do printf '%-50s %s\n' "~/$f" "$([ -e "$HOME/$f" ] && echo ok || echo MISSING)"; done
  printf '%-50s %s\n' "mirror $M" "$(sudo -n test -r $M/conf && echo ok || echo MISSING)"
  tail -5 "$LOG" 2>/dev/null; exit 0
fi

# Only the real VM may take back the Tailscale identity: a fork or a check copy runs on another
# machine. `boat info self` needs BOAT_ID in the shell, which not every VM has, so compare the
# public IPv6 boat reports for $BOAT_ID with the addresses on this machine.
SELF=""
self_ok() {
  # Cache only a pass: a miss (network still coming up) is checked again on the next call.
  [ "$SELF" = yes ] && return 0
  self_check && SELF=yes; [ "$SELF" = yes ]
}
self_check() {
  local ip; ip=$(boat info "$BOAT_ID" --json 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin)["sandbox"]["ip"] or "")' 2>/dev/null)
  [ -n "$ip" ] && ip -6 -o addr show scope global 2>/dev/null | awk '{print $4}' | grep -qix "$ip/128"
}

# 1. Put back missing system files from the copy in /home.
missing=0; for f in "${WANT[@]}"; do [ -e "$f" ] || missing=1; done
if [ $missing = 1 ] && [ -s "$D/system.tgz" ]; then
  if self_ok; then
    $S tar -xzpf "$D/system.tgz" -C / --skip-old-files 2>/dev/null && say "restored missing system files from $D/system.tgz"
  else say "system files missing but this is not $BOAT_ID; not restoring"; fi
fi

# 1b. The login shell (zsh) vanished on investor-os (21 Nov 2026): sshd then refuses every login
# ("shell /usr/bin/zsh does not exist"), so Zed and ssh from the Mac fail.
sh=$(getent passwd "$(id -u)" | cut -d: -f7)
if [ -n "$sh" ] && [ ! -x "$sh" ]; then
  $S apt-get update -qq >/dev/null 2>&1
  $S env DEBIAN_FRONTEND=noninteractive apt-get install --reinstall -y -qq "$(basename "$sh")" >/dev/null 2>&1
  [ -x "$sh" ] && say "reinstalled the login shell $sh (it was missing)" || say "login shell $sh missing and reinstall failed"
fi

# 1c. Home files: put back the bundle if a key file is gone (never overwrites).
missing_home=0; for f in "${HOME_WANT[@]}"; do [ -e "$HOME/$f" ] || missing_home=1; done
if [ $missing_home = 1 ] && [ -s "$D/home.tgz" ] && self_ok; then
  tar -xzpf "$D/home.tgz" -C "$HOME" --skip-old-files 2>/dev/null && say "restored missing home files (git, GitHub key, T3) from $D/home.tgz"
  chmod 700 "$HOME/.ssh" 2>/dev/null; systemctl --user daemon-reload 2>/dev/null
fi

# 2. Tailscale installed, its identity in place, running.
if ! command -v tailscaled >/dev/null; then
  if [ -e /etc/apt/sources.list.d/tailscale.list ]; then $S apt-get update -qq >/dev/null 2>&1; $S env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq tailscale >/dev/null 2>&1; fi
  command -v tailscaled >/dev/null || curl -fsSL https://tailscale.com/install.sh | $S sh >/dev/null 2>&1
  hash -r
  command -v tailscaled >/dev/null && say "reinstalled Tailscale $(tailscale version | head -1)" || say "Tailscale missing and reinstall failed"
fi
ts_state() { tailscale status --json 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin).get("BackendState",""))' 2>/dev/null; }
ts_in() { [ "$(ts_state)" = Running ]; }
# Restore the identity when the state file is gone, or when a fresh install made a new logged-out one.
if command -v tailscaled >/dev/null && [ -s "$D/tailscaled.state" ] \
   && { ! $S test -s /var/lib/tailscale/tailscaled.state || { systemctl is-active --quiet tailscaled && [ "$(ts_state)" = NeedsLogin ]; }; } \
   && ! $S cmp -s /var/lib/tailscale/tailscaled.state "$D/tailscaled.state" && self_ok; then
  $S systemctl stop tailscaled 2>/dev/null
  $S install -D -m 600 -o root -g root "$D/tailscaled.state" /var/lib/tailscale/tailscaled.state && say "restored the Tailscale identity (node key) from the copy in /home"
fi
if command -v tailscaled >/dev/null; then
  systemctl is-enabled --quiet tailscaled 2>/dev/null || $S systemctl enable tailscaled >/dev/null 2>&1
  # Never on a copy: it would join the tailnet as this VM (erivault-check, 12 Nov 2026).
  systemctl is-active --quiet tailscaled || { self_ok && $S systemctl start tailscaled && say "started tailscaled (was stopped)"; }
fi

# 2b. SSH host keys: keep the first ones, so the Mac keeps trusting the VM after a fresh boot.
if [ -s "$D/sshhost.tgz" ] && $S test -e /etc/ssh/ssh_host_ed25519_key.pub \
   && ! tar -xzOf "$D/sshhost.tgz" etc/ssh/ssh_host_ed25519_key.pub 2>/dev/null | cmp -s - /etc/ssh/ssh_host_ed25519_key.pub \
   && self_ok; then
  $S tar -xzpf "$D/sshhost.tgz" -C / && { $S systemctl restart ssh 2>/dev/null; say "put back the saved SSH host keys (boot had made new ones)"; }
fi

# 3. Our system timers: systemd read its units before boat restored them, so reload and start.
if { [ -e /etc/systemd/system/$P-keepalive.timer ] && ! systemctl is-active --quiet $P-keepalive.timer; } \
   || { [ -e /etc/systemd/system/boat-idle-stop.timer ] && ! systemctl is-active --quiet boat-idle-stop.timer; }; then
  $S systemctl daemon-reload
  for u in $P-hostname.service $P-keepalive.timer boat-idle-stop.timer; do
    [ -e /etc/systemd/system/$u ] || continue
    self_ok || continue   # the keepalive starts tailscaled and idle-stop stops "self": real VM only
    systemctl is-active --quiet $u || { $S systemctl enable --now $u >/dev/null 2>&1 && say "started $u"; }
  done
fi
[ "$(hostname)" = "$P" ] || { $S hostnamectl set-hostname "$P" && say "hostname set back to $P"; }

# 4. User services: T3 and the hourly agent-config sync.
systemctl --user is-active --quiet t3code.service || { systemctl --user daemon-reload; systemctl --user start t3code.service && say "started t3code"; }
if [ -e "$HOME/.config/systemd/user/vm-setup-sync.timer" ] && ! systemctl --user is-active --quiet vm-setup-sync.timer; then
  systemctl --user daemon-reload; systemctl --user start vm-setup-sync.timer && say "started vm-setup-sync.timer"
fi

# 5. Tailscale serve for T3 (lives in the node state; only needed if the state was new).
if tailscale status --self --peers=false >/dev/null 2>&1 && ! tailscale serve status 2>/dev/null | grep -q 127.0.0.1:3773; then
  tailscale serve --bg --https=443 http://127.0.0.1:3773 >/dev/null 2>&1 && say "re-added tailscale serve for T3"
fi

# 6. 1Password CLI (agents read secrets with op).
if ! command -v op >/dev/null && [ -e /etc/apt/sources.list.d/1password.list ]; then
  $S apt-get update -qq >/dev/null 2>&1; $S env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq 1password-cli >/dev/null 2>&1 && say "reinstalled 1Password CLI"
fi

# 7. Refresh the copies in /home while everything is present (at most every 6 h, or when missing).
healthy=1; for f in "${WANT[@]}"; do [ -e "$f" ] || healthy=0; done
if [ $healthy = 1 ]; then
  need_tgz=0; need_state=0
  { [ ! -s "$D/system.tgz" ] || [ -n "$(find "$D/system.tgz" -mmin +360 2>/dev/null)" ]; } && need_tgz=1
  # Only ever back up a signed-in node: a fresh install's logged-out state once overwrote the good copy.
  ts_in && $S test -s /var/lib/tailscale/tailscaled.state && ! $S cmp -s /var/lib/tailscale/tailscaled.state "$D/tailscaled.state" 2>/dev/null && need_state=1
  if [ $need_tgz = 1 ] || [ $need_state = 1 ]; then
    if self_ok; then
      [ $need_tgz = 1 ] && files | $S tar -czpf "$D/system.tgz.new" -T - 2>/dev/null && $S chown "$(id -u):$(id -g)" "$D/system.tgz.new" && chmod 600 "$D/system.tgz.new" && mv "$D/system.tgz.new" "$D/system.tgz"
      [ $need_state = 1 ] && $S install -m 600 -o "$(id -u)" -g "$(id -g)" /var/lib/tailscale/tailscaled.state "$D/tailscaled.state"
    fi
  fi
  if getent passwd user >/dev/null && ! cmp -s /etc/passwd "$D/passwd" 2>/dev/null; then
    cp /etc/passwd "$D/passwd.new" && chmod 600 "$D/passwd.new" && mv "$D/passwd.new" "$D/passwd"
  fi
  if getent group docker >/dev/null && ! cmp -s /etc/group "$D/group" 2>/dev/null; then
    cp /etc/group "$D/group.new" && chmod 600 "$D/group.new" && mv "$D/group.new" "$D/group"
  fi
  if $S test -s /etc/gshadow && ! $S cmp -s /etc/gshadow "$D/gshadow" 2>/dev/null; then
    $S cat /etc/gshadow > "$D/gshadow.new" && chmod 600 "$D/gshadow.new" && mv "$D/gshadow.new" "$D/gshadow"
  fi
  # First SSH host keys only: later boots get them put back by step 2b.
  if [ ! -s "$D/sshhost.tgz" ] && self_ok; then
    (cd / && $S tar -czpf "$D/sshhost.tgz" etc/ssh/ssh_host_*) 2>/dev/null && $S chown "$(id -u):$(id -g)" "$D/sshhost.tgz" && chmod 600 "$D/sshhost.tgz"
  fi
fi
# Home bundle: refresh every 6 h while the key files are all there.
home_ok=1; for f in "${HOME_WANT[@]}"; do [ -e "$HOME/$f" ] || home_ok=0; done
if [ $home_ok = 1 ] && { [ ! -s "$D/home.tgz" ] || [ -n "$(find "$D/home.tgz" -mmin +360 2>/dev/null)" ]; } && self_ok; then
  home_files | tar -czpf "$D/home.tgz.new" -C "$HOME" -T - 2>/dev/null && chmod 600 "$D/home.tgz.new" && mv "$D/home.tgz.new" "$D/home.tgz"
fi
# Mirror this folder outside /home (root only), so one lost folder does not lose both copies.
if [ -s "$D/conf" ] && self_ok && { ! $S test -d $M || [ -n "$(find "$D" -newer "$D/.mirrored" -type f 2>/dev/null | head -1)" ] || [ ! -e "$D/.mirrored" ]; }; then
  $S mkdir -p -m 700 $M && $S cp -a "$D"/. $M/ && touch "$D/.mirrored"
fi

# 8. Repos: a restore once left repos with no .git/HEAD (21 Nov 2026). Rebuilding needs GitHub,
# so only say so, at most once an hour.
if [ -z "$(find "$D/.repo-check" -mmin -60 2>/dev/null)" ]; then
  touch "$D/.repo-check"
  for g in "$HOME"/code/*/*/.git; do
    case "$g" in *broken*) continue;; esac
    [ -d "$g" ] && [ ! -e "$g/HEAD" ] && say "repo damaged: ${g%/.git} has no .git/HEAD (rebuild it from GitHub)"
  done
fi
exit 0
