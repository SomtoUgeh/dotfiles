#!/usr/bin/env bash
# vm-heal: put a boat project VM back together after a resume. Runs as `user`.
#
# Why (18 Nov 2026): on resume boat boots the machine from its base image, then restores the
# saved disk lazily (ascii-agents-server "[restore] ... lazyfs staging"). systemd has already
# read its units by then, so our enabled units (tailscaled, <p>-keepalive.timer,
# boat-idle-stop.timer, agent-config-sync.timer) never start. On erivault the restore even came
# back with the base image's /etc, /usr and /var (Tailscale uninstalled, its node key gone,
# our timers gone) while /home/user was intact. This script lives in /home, which always
# survives, keeps a copy of our system files there, and puts back whatever is missing.
#
# Triggers (all safe to overlap, a lock keeps one run at a time):
#   ~/.config/autostart/vm-heal.desktop   boat restarts the desktop session after the restore
#   /etc/cron.d/vm-heal                   every minute; cron rescans cron.d, systemd does not
#   the Mac's `vm up` / julds-autowake    `boat ssh <id> -- .local/bin/vm-heal` after a resume
#
# Usage: vm-heal            one pass (quiet unless it changes something)
#        vm-heal --loop     one pass now, then every 5 min (autostart)
#        vm-heal --status   show what it checks
#        vm-heal --setup <project> <sandbox id>   first-time install on a VM
set -uo pipefail
D="$HOME/.local/share/vm-heal"; LOG="$HOME/.local/state/vm-heal.log"
mkdir -p "$D" "$(dirname "$LOG")"
export XDG_RUNTIME_DIR=/run/user/$(id -u) PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
S="sudo -n"
say() { echo "$(date -u +%FT%TZ) $*" >> "$LOG"; logger -t vm-heal "$*" 2>/dev/null; [ -t 1 ] && echo "$*"; }

if [ "${1:-}" = --setup ]; then
  printf 'P=%s\nBOAT_ID=%s\n' "${2:?project}" "${3:?sandbox id}" > "$D/conf"
  mkdir -p "$HOME/.config/autostart"
  cat > "$HOME/.config/autostart/vm-heal.desktop" <<A
[Desktop Entry]
Type=Application
Name=vm-heal
Comment=Put Tailscale, T3 and the VM timers back after a boat resume
Exec=$HOME/.local/bin/vm-heal --loop
X-GNOME-Autostart-enabled=true
NoDisplay=true
A
  echo "* * * * * user $HOME/.local/bin/vm-heal" | $S tee /etc/cron.d/vm-heal >/dev/null
  $S chmod 644 /etc/cron.d/vm-heal
  set -- ""
fi

[ -r "$D/conf" ] || { echo "vm-heal: not set up (vm-heal --setup <project> <sandbox id>)"; exit 0; }
. "$D/conf"

if [ "${1:-}" = --loop ]; then
  while :; do "$0"; sleep 300; done
fi

exec 9>/tmp/vm-heal.lock; flock -n 9 || exit 0

# Files we own outside /home. Kept in $D/system.tgz while they are all present.
files() {
  local f
  for f in \
    /etc/systemd/system/$P-hostname.service \
    /etc/systemd/system/multi-user.target.wants/$P-hostname.service \
    /usr/local/sbin/$P-keepalive \
    /etc/systemd/system/$P-keepalive.service /etc/systemd/system/$P-keepalive.timer \
    /etc/systemd/system/timers.target.wants/$P-keepalive.timer \
    /usr/local/sbin/boat-idle-stop /usr/local/bin/vm-stay /etc/boat-idle.env \
    /etc/systemd/system/boat-idle-stop.service /etc/systemd/system/boat-idle-stop.timer \
    /etc/systemd/system/timers.target.wants/boat-idle-stop.timer \
    /etc/boat-check.env /etc/cron.d/vm-heal /var/lib/systemd/linger/user \
    /etc/apt/sources.list.d/tailscale.list /usr/share/keyrings/tailscale-archive-keyring.gpg \
    /etc/apt/sources.list.d/1password.list /usr/share/keyrings/1password-archive-keyring.gpg \
    /etc/systemd/system/*.d/90-t3code-protect.conf; do
    [ -e "$f" ] || [ -L "$f" ] && echo "$f"
  done
}
WANT=(/usr/local/sbin/$P-keepalive /etc/systemd/system/$P-keepalive.timer /usr/local/sbin/boat-idle-stop
      /etc/systemd/system/boat-idle-stop.timer /etc/boat-idle.env /etc/systemd/system/$P-hostname.service
      /etc/cron.d/vm-heal)

if [ "${1:-}" = --status ]; then
  echo "project $P, sandbox $BOAT_ID, host $(hostname)"
  for f in "${WANT[@]}"; do printf '%-50s %s\n' "$f" "$([ -e "$f" ] && echo ok || echo MISSING)"; done
  for u in tailscaled $P-keepalive.timer boat-idle-stop.timer; do printf '%-50s %s\n' "$u" "$(systemctl is-active $u)"; done
  printf '%-50s %s\n' "t3code (user)" "$(systemctl --user is-active t3code.service)"
  printf '%-50s %s\n' "tailscale" "$(tailscale status --self --peers=false 2>&1 | head -1)"
  printf '%-50s %s\n' "backup" "$(ls -l --time-style=+%F\ %R "$D/system.tgz" 2>/dev/null | awk '{print $6, $7}')"
  tail -5 "$LOG" 2>/dev/null; exit 0
fi

# Only the real VM may take back the Tailscale identity: a fork or a check copy runs on another
# machine. `boat info self` needs BOAT_ID in the shell, which not every VM has, so compare the
# public IPv6 boat reports for $BOAT_ID with the addresses on this machine.
self_ok() {
  local ip; ip=$(boat info "$BOAT_ID" --json 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin)["sandbox"]["ip"] or "")' 2>/dev/null)
  [ -n "$ip" ] && ip -6 -o addr show scope global 2>/dev/null | awk '{print $4}' | grep -qix "$ip/128"
}

# 1. Put back missing system files from the copy in /home.
missing=0; for f in "${WANT[@]}"; do [ -e "$f" ] || missing=1; done
if [ $missing = 1 ] && [ -s "$D/system.tgz" ]; then
  if self_ok; then
    $S tar -xzpf "$D/system.tgz" -C / --skip-old-files 2>/dev/null && say "restored missing system files from $D/system.tgz"
  else say "system files missing but this is not $BOAT_ID; not restoring"; fi
fi

# 2. Tailscale installed, its identity in place, running.
if ! command -v tailscaled >/dev/null; then
  if [ -e /etc/apt/sources.list.d/tailscale.list ]; then $S apt-get update -qq >/dev/null 2>&1; $S env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq tailscale >/dev/null 2>&1
  else curl -fsSL https://tailscale.com/install.sh | $S sh >/dev/null 2>&1; fi
  command -v tailscaled >/dev/null && say "reinstalled Tailscale $(tailscale version | head -1)" || say "Tailscale missing and reinstall failed"
fi
if command -v tailscaled >/dev/null && ! $S test -s /var/lib/tailscale/tailscaled.state && [ -s "$D/tailscaled.state" ] && self_ok; then
  $S systemctl stop tailscaled 2>/dev/null
  $S install -D -m 600 -o root -g root "$D/tailscaled.state" /var/lib/tailscale/tailscaled.state && say "restored the Tailscale identity (node key) from the copy in /home"
fi
if command -v tailscaled >/dev/null; then
  systemctl is-enabled --quiet tailscaled 2>/dev/null || $S systemctl enable tailscaled >/dev/null 2>&1
  systemctl is-active --quiet tailscaled || { $S systemctl start tailscaled && say "started tailscaled (was stopped)"; }
fi

# 3. Our system timers: systemd read its units before boat restored them, so reload and start.
if { [ -e /etc/systemd/system/$P-keepalive.timer ] && ! systemctl is-active --quiet $P-keepalive.timer; } \
   || { [ -e /etc/systemd/system/boat-idle-stop.timer ] && ! systemctl is-active --quiet boat-idle-stop.timer; }; then
  $S systemctl daemon-reload
  for u in $P-hostname.service $P-keepalive.timer boat-idle-stop.timer; do
    [ -e /etc/systemd/system/$u ] || continue
    systemctl is-active --quiet $u || { $S systemctl enable --now $u >/dev/null 2>&1 && say "started $u"; }
  done
fi
[ "$(hostname)" = "$P" ] || { $S hostnamectl set-hostname "$P" && say "hostname set back to $P"; }

# 4. User services: T3 and the hourly agent-config sync.
systemctl --user is-active --quiet t3code.service || { systemctl --user daemon-reload; systemctl --user start t3code.service && say "started t3code"; }
if [ -e "$HOME/.config/systemd/user/agent-config-sync.timer" ] && ! systemctl --user is-active --quiet agent-config-sync.timer; then
  systemctl --user daemon-reload; systemctl --user start agent-config-sync.timer && say "started agent-config-sync.timer"
fi

# 5. Tailscale serve for T3 (lives in the node state; only needed if the state was new).
if tailscale status --self --peers=false >/dev/null 2>&1 && ! tailscale serve status 2>/dev/null | grep -q 127.0.0.1:3773; then
  tailscale serve --bg --https=443 http://127.0.0.1:3773 >/dev/null 2>&1 && say "re-added tailscale serve for T3"
fi

# 6. 1Password CLI (agents read secrets with op).
if ! command -v op >/dev/null && [ -e /etc/apt/sources.list.d/1password.list ]; then
  $S apt-get update -qq >/dev/null 2>&1; $S env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq 1password-cli >/dev/null 2>&1 && say "reinstalled 1Password CLI"
fi

# 7. Refresh the copies in /home while everything is present (at most every 6 h, or when missing).
healthy=1; for f in "${WANT[@]}"; do [ -e "$f" ] || healthy=0; done
if [ $healthy = 1 ]; then
  need_tgz=0; need_state=0
  { [ ! -s "$D/system.tgz" ] || [ -n "$(find "$D/system.tgz" -mmin +360 2>/dev/null)" ]; } && need_tgz=1
  $S test -s /var/lib/tailscale/tailscaled.state && ! $S cmp -s /var/lib/tailscale/tailscaled.state "$D/tailscaled.state" 2>/dev/null && need_state=1
  if [ $need_tgz = 1 ] || [ $need_state = 1 ]; then
    if self_ok; then
      [ $need_tgz = 1 ] && files | $S tar -czpf "$D/system.tgz.new" -T - 2>/dev/null && $S chown "$(id -u):$(id -g)" "$D/system.tgz.new" && chmod 600 "$D/system.tgz.new" && mv "$D/system.tgz.new" "$D/system.tgz"
      [ $need_state = 1 ] && $S install -m 600 -o "$(id -u)" -g "$(id -g)" /var/lib/tailscale/tailscaled.state "$D/tailscaled.state"
    fi
  fi
fi
exit 0
