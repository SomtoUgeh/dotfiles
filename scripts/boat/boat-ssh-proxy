#!/bin/sh
# SSH ProxyCommand for boat VMs without working Tailscale (added 21 Nov 2026).
# Looks up the sandbox's current boat SSH endpoint (it changes on every resume) and connects to it.
# Usage in ~/.ssh/config:  ProxyCommand ~/.local/bin/boat-ssh-proxy <sandbox-id>
ep=$(BOAT_NO_UPDATE=1 /usr/local/bin/boat info "$1" --json 2>/dev/null | /usr/bin/python3 -c 'import json,sys;print(json.load(sys.stdin)["sandbox"].get("sshEndpoint") or "")')
[ -n "$ep" ] || { echo "boat-ssh-proxy: no SSH endpoint for $1 (VM stopped? run: vm up)" >&2; exit 1; }
exec /usr/bin/nc "${ep%:*}" "${ep##*:}"
