#!/usr/bin/env bash
# Stop this project VM after IDLE_MIN quiet minutes, so it costs nothing while unused.
# Runs every 5 minutes from boat-idle-stop.timer as root. Config: /etc/boat-idle.env. Log: journalctl -t boat-idle.
# Busy (resets the clock): a T3 run not finished, T3 activity newer than the last check, an interactive
# terminal (pts) used in the last 30 min, user CPU above CPU_MAX percent, or a hold (`vm-stay <hours>` writes /var/lib/boat-idle/hold-until).
# A stop keeps the disk: files, repos, worktrees, T3 threads and logins come back on resume; only hand-started
# processes do not (boat docs, Nov 2026). julds is never set up with this.
set -u
[ -f /etc/boat-idle.env ] && . /etc/boat-idle.env
IDLE_MIN=${IDLE_MIN:-45}; CPU_MAX=${CPU_MAX:-40}; ENABLED=${ENABLED:-1}; DRY_RUN=${DRY_RUN:-0}
S=/var/lib/boat-idle; mkdir -p "$S"; now=$(date +%s)
log() { logger -t boat-idle "$*"; }
busy() { echo "$now" > "$S/last-active"; echo "$1" > "$S/last-reason"; exit 0; }
[ "$ENABLED" = 1 ] || exit 0
[ -n "${BOAT_ID:-}" ] || { log "BOAT_ID not set in /etc/boat-idle.env"; exit 0; }
# A gap of 15+ minutes since the last check means the VM was stopped and resumed: start a fresh idle window.
prev=$(cat "$S/last-check" 2>/dev/null || echo 0); echo "$now" > "$S/last-check"
[ $(( now - prev )) -gt 900 ] && busy "resumed (no check for $(( (now - prev) / 60 )) min)"
hold=$(cat "$S/hold-until" 2>/dev/null || echo 0); [ "$now" -lt "$hold" ] && busy "hold until $(date -d @$hold '+%F %T')"
# T3: unfinished runs (started in the last 12 h, so a stuck row cannot keep it awake forever) and the newest activity.
read -r open newest < <(runuser -u user -- python3 - <<'P' 2>/dev/null || echo "0 0"
import sqlite3,os,time,datetime
def ts(v):
    if v is None: return 0
    try: return float(v)/1000 if float(v)>1e11 else float(v)
    except: pass
    try: return datetime.datetime.fromisoformat(str(v).replace('Z','+00:00')).timestamp()
    except: return 0
db=sqlite3.connect('file:'+os.path.expanduser('~/.t3/userdata/statev2.sqlite')+'?mode=ro',uri=True)
now=time.time(); done=('completed','failed','cancelled','interrupted','rolled_back')
rows=db.execute("select status,requested_at,completed_at from orchestration_v2_projection_runs").fetchall()
open_=sum(1 for s,r,c in rows if s not in done and now-ts(r)<12*3600)
newest=max([max(ts(r),ts(c)) for s,r,c in rows] or [0])
print(open_, int(newest))
P
)
[ "${open:-0}" -gt 0 ] && busy "$open T3 run(s) not finished"
last=$(cat "$S/last-active" 2>/dev/null || echo "$now"); [ -f "$S/last-active" ] || echo "$now" > "$S/last-active"
[ "${newest:-0}" -gt "$last" ] && busy "T3 activity at $(date -d @$newest '+%F %T')"
# Terminal sessions (pts) used in the last 30 minutes. boat's desktop login on tty7 (:0) is always there; skip it.
active_tty=$(who -u | awk '$2 ~ /^pts/ { i=$5; if (i==".") n++; else if (i ~ /^[0-9][0-9]:[0-9][0-9]$/) { split(i,t,":"); if (t[1]*60+t[2] < 30) n++ } } END { print n+0 }')
[ "$active_tty" -gt 0 ] && busy "terminal session in use"
# CPU used right now by the user's own processes (builds, tests, agents). boat's snapshot and download
# work runs as root and is left out, so it cannot keep the VM awake.
cpu=$(top -b -n 2 -d 3 -u user | awk '/^ *PID/{blk++; next} blk==2 {s+=$9} END{printf "%d", s}')
[ "${cpu:-0}" -gt "$CPU_MAX" ] && busy "user CPU ${cpu}%"
idle=$(( (now - last) / 60 ))
[ "$idle" -lt "$IDLE_MIN" ] && exit 0
if [ "$DRY_RUN" = 1 ]; then log "dry run: idle ${idle} min, would stop now"; exit 0; fi
log "idle ${idle} min (last: $(cat $S/last-reason 2>/dev/null)), stopping"
echo "$now" > "$S/last-active"   # a resume starts a fresh idle window
BOAT_NO_UPDATE=1 runuser -u user -- env BOAT_ID="$BOAT_ID" BOAT_NO_UPDATE=1 /home/user/.ascii/bin/boat stop self --json >/dev/null 2>&1 || log "boat stop failed"
