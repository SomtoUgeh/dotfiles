#!/usr/bin/env bash
# boat-check: run a heavy check (typecheck, tests, e2e, build) on a throwaway boat
# machine started from this project's saved snapshot, and stream the output back.
#
#   boat-check [--size small|default|large] [--timeout SECS] [--local] -- <command...>
#   boat-check -- bun run check-types
#   boat-check --size large -- bash -c 'cd e2e && bun run test:signin'
#
# The machine starts from $BOAT_CHECK_SNAPSHOT (repo cloned at ~/$BOAT_CHECK_REPO_PATH
# with node_modules installed), gets this worktree's files (git-tracked plus new files
# that .gitignore does not exclude), runs the command, prints time and cost, and is
# deleted. The exit code is the command's exit code.
#
# Config: /etc/boat-check.env (project, snapshot, environment, repo path, install cmd).
# Key:    ~/.config/boat-check/key (a ci-preset boat API key scoped to the environment).
# If boat refuses the start (rate limit, no machine), the command runs here instead,
# unless BOAT_CHECK_NO_FALLBACK=1.
set -euo pipefail

CONFIG=${BOAT_CHECK_CONFIG:-/etc/boat-check.env}
[ -r "$CONFIG" ] || { echo "boat-check: missing $CONFIG" >&2; exit 2; }
# shellcheck source=/dev/null
. "$CONFIG"
: "${BOAT_CHECK_PROJECT:?}" "${BOAT_CHECK_SNAPSHOT:?}" "${BOAT_CHECK_ENVIRONMENT:?}" "${BOAT_CHECK_REPO_PATH:?}" "${BOAT_CHECK_INSTALL:?}"

size=${BOAT_CHECK_SIZE:-default}
timeout=${BOAT_CHECK_TIMEOUT:-1800}
local_only=0
while [ $# -gt 0 ]; do
  case $1 in
    --size) size=$2; shift 2 ;;
    --timeout) timeout=$2; shift 2 ;;
    --local) local_only=1; shift ;;
    --) shift; break ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || { echo "usage: boat-check [--size S] [--timeout SECS] [--local] -- <command...>" >&2; exit 2; }

root=$(git rev-parse --show-toplevel)
prefix=$(git rev-parse --show-prefix)
branch=$(git rev-parse --abbrev-ref HEAD | tr -c 'A-Za-z0-9._-' '-' | cut -c1-60)
cmd=$(printf '%q ' "$@")

run_local() {
  echo "boat-check: running locally: $1" >&2
  cd "$root/$prefix"
  exec bash -c "$cmd"
}
[ "$local_only" = 1 ] && run_local "--local"

key_file=${BOAT_CHECK_KEY_FILE:-$HOME/.config/boat-check/key}
[ -r "$key_file" ] || { echo "boat-check: missing key file $key_file" >&2; exit 2; }
BOAT_API_KEY=$(cat "$key_file")
export BOAT_API_KEY BOAT_NO_UPDATE=1

# Remote script: rename the machine, swap the pushed files into the snapshot's clone
# (keeps node_modules), install only what changed, run the command, report hydration.
remote=$(cat <<EOF
set -uo pipefail
export LC_ALL=C.UTF-8
echo "boat-check: started on \$(boat info self --json 2>/dev/null | jq -r .sandbox.id) (${BOAT_CHECK_SNAPSHOT}, ${size})" >&2
# A base copied from the live VM carries its Tailscale node and T3 server. Take this
# throwaway machine off the tailnet before anything else so it cannot pose as the VM.
if sudo -n test -s /var/lib/tailscale/tailscaled.state 2>/dev/null || systemctl --user is-enabled --quiet t3code.service 2>/dev/null; then
  echo "boat-check: WARNING ${BOAT_CHECK_SNAPSHOT} carries the VM's Tailscale/T3 identity; stopping it here. Rebuild the base with scripts/boat/clean-base.sh." >&2
  sudo -n systemctl stop ${BOAT_CHECK_PROJECT}-keepalive.timer tailscaled 2>/dev/null || true
  systemctl --user stop t3code.service 2>/dev/null || true
fi
boat rename self "${BOAT_CHECK_PROJECT}-check-${branch}" >/dev/null 2>&1 || true
src=\$HOME/$(basename "$root") dst=\$HOME/${BOAT_CHECK_REPO_PATH}
t0=\$(date +%s)
cd "\$dst"
git ls-files -z | xargs -0 rm -f --
cp -a "\$src"/. "\$dst"/
rm -rf "\$src"
t1=\$(date +%s)
${BOAT_CHECK_INSTALL} >/tmp/boat-check-install.log 2>&1 || { cat /tmp/boat-check-install.log; exit 1; }
t2=\$(date +%s)
echo "boat-check: sync \$((t1-t0))s, install \$((t2-t1))s" >&2
cd "\$dst/${prefix}"
start=\$(date +%s)
bash -c $(printf '%q' "$cmd")
rc=\$?
info=\$(boat info self --json 2>/dev/null)
echo "boat-check: command exit \$rc in \$(( \$(date +%s) - start ))s; hydrated=\$(jq -r .sandbox.hydrated <<<"\$info") createdAt=\$(jq -r .sandbox.createdAt <<<"\$info") hydratedAt=\$(jq -r .sandbox.hydratedAt <<<"\$info")"
exit \$rc
EOF
)

errlog=$(mktemp)
trap 'rm -f "$errlog"' EXIT
set +e
boat run --from "$BOAT_CHECK_SNAPSHOT" --environment "$BOAT_CHECK_ENVIRONMENT" --type "$size" \
  --push "$root" --timeout "$timeout" -- bash -lc "$remote" 2> >(tee "$errlog" >&2)
rc=$?
set -e
wait

if [ "$rc" -ne 0 ] && [ "${BOAT_CHECK_NO_FALLBACK:-0}" != 1 ] \
  && ! grep -q 'boat-check: started on' "$errlog" \
  && grep -qE 'rate_limited|no_ready_machine|credit_required|start limit' "$errlog"; then
  run_local "boat refused the start ($(grep -oE 'rate_limited|no_ready_machine|credit_required|start limit' "$errlog" | head -1))"
fi
exit "$rc"
