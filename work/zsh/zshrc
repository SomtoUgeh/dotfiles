#!/bin/zsh
# Work Mac ~/.zshrc (linked by work/install.sh).
#
# Same shell as the personal Mac (Oh My Zsh, Starship, shared aliases), without
# the personal tools. Put company values (hosts, tokens, proxies) in
# ~/.zshrc.private. Never add them here: this repository is public.

# Remove the project-relative entry, also when inherited, so a checkout's
# node_modules/.bin cannot shadow direnv or starship at startup.
path=("${(@)path:#./node_modules/.bin}")

# ============================================================================
# OH MY ZSH
# ============================================================================

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # Starship draws the prompt

plugins=(fzf-tab zsh-autosuggestions fast-syntax-highlighting)

ZSH_DISABLE_COMPFIX=true
[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# ============================================================================
# SHELL
# ============================================================================

export TERM=xterm-256color
export CLICOLOR=1
export LSCOLORS=Fafacxdxbxegedabagacad

setopt promptsubst

HISTSIZE=5000
HISTFILESIZE=10000
SAVEHIST=5000
HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_DUPS

# `cd projectname` jumps into ~/code/work/projectname.
CDPATH=.:$HOME:$HOME/code:$HOME/code/work:$HOME/Desktop

# Pass unmatched globs as literal strings (keeps [ABC-1234] usable in commands)
setopt NO_NOMATCH

# ============================================================================
# TOOLS
# ============================================================================

PATH="/opt/homebrew/bin:$PATH"

# fnm switches Node per project from .nvmrc / .node-version
command -v fnm >/dev/null && eval "$(fnm env --use-on-cd)"

export BUN_INSTALL="$HOME/.bun"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

export PNPM_HOME="$HOME/Library/pnpm"
[ -d "$PNPM_HOME/bin" ] && case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

command -v direnv >/dev/null && eval "$(direnv hook zsh)"

# 1Password shell plugins, created by `op plugin init`
[[ -r "$HOME/.config/op/plugins.sh" ]] && source "$HOME/.config/op/plugins.sh"

source ~/.orbstack/shell/init.zsh 2>/dev/null || :

# File-held GitLab keys (setup_gitlab.sh --keys file): load them from the
# Keychain into the macOS ssh-agent after a restart, so git can sign commits.
[[ -f "$HOME/.ssh/gitlab_sign_ed25519" ]] && ssh-add --apple-load-keychain -q 2>/dev/null

if [[ -f "$HOME/.ripgreprc" ]]; then
  export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"
fi
export SCARF_ANALYTICS=false

# ============================================================================
# COMPLETIONS
# ============================================================================

autoload -Uz compinit && compinit -u
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# ============================================================================
# ALIASES AND FUNCTIONS
# ============================================================================

# Shared with the personal Mac. :A resolves the ~/.zshrc symlink to this file.
source "${${(%):-%x}:A:h}/../../shell/aliases.zsh"

# ============================================================================
# PRIVATE CONFIG
# ============================================================================

[ -f ~/.zshrc.private ] && source ~/.zshrc.private

# ============================================================================
# PROMPT (keep last)
# ============================================================================

export STARSHIP_CONFIG="$HOME/.config/starship.toml"
command -v starship >/dev/null && eval "$(starship init zsh)"
