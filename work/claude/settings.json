{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "outputStyle": "bro",
  "theme": "dark",
  "effortLevel": "high",
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000"
  },
  "statusLine": {
    "type": "command",
    "command": "\"${HOME}/.claude/statusline.sh\"",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${HOME}/.claude/hooks/git_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
