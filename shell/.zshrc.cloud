#!/usr/bin/env zsh

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
ZSH_DISABLE_COMPFIX=true
plugins=(fzf-tab zsh-autosuggestions fast-syntax-highlighting)

[[ -d "$HOME/.grok/completions/zsh" ]] && fpath=("$HOME/.grok/completions/zsh" $fpath)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

export TERM="${TERM:-xterm-256color}"
export BUN_INSTALL="$HOME/.bun"
export STARSHIP_CONFIG="$HOME/.config/starship.toml"

HISTFILE="$HOME/.zsh_history"
HISTSIZE=5000
SAVEHIST=5000
setopt APPEND_HISTORY HIST_IGNORE_DUPS INC_APPEND_HISTORY NO_NOMATCH SHARE_HISTORY

cdpath=(. "$HOME" "$HOME/code" "$HOME/code/TalentQL" "$HOME/code/personal")

[[ -r "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

command -v direnv >/dev/null && eval "$(direnv hook zsh)"
command -v starship >/dev/null && eval "$(starship init zsh)"

alias d='cd ~/code'
alias personal='cd ~/code/personal'
alias talentql='cd ~/code/TalentQL/altschool-web-platforms'
alias gs='git status'
alias gp='git pull'
alias gf='git fetch'
alias gd='git diff'
alias bi='bun install'
alias grok='grok --always-approve'

if command -v eza >/dev/null; then
  alias ls='eza --icons=auto --group-directories-first'
  alias ll='eza -l --icons=auto --group-directories-first'
  alias la='eza -a --icons=auto --group-directories-first'
  alias lla='eza -la --icons=auto --group-directories-first'
fi

command -v bat >/dev/null && alias cat='bat'

[[ -r "$HOME/.zshrc.private" ]] && source "$HOME/.zshrc.private"
