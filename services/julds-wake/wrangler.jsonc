{
  // Phone wake button for the julds boat VM. Deploy from the julds VM:
  //   set -a; . ~/.config/executor-v2-julds/env; set +a; npx wrangler@4 deploy
  // Secrets: BOAT_KEY (1Password "boat julds wake key", vault "Julds VM"; resume + read on bx_2jd5dd8b only)
  // and BOAT_KEY_VMS (boat key "julds-wake-page-vms"; resume + read on the five project VMs only).
  "name": "julds-wake",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "triggers": { "crons": ["0 3 * * SUN"] },
  "routes": [{ "pattern": "wake.julds.com", "custom_domain": true }],
  "send_email": [{ "name": "EMAIL", "destination_address": "smugeh@gmail.com", "allowed_sender_addresses": ["julds@alerts.julds.com"] }],
  "vars": {
    "ALERT_TO": "smugeh@gmail.com",
    "ALERT_FROM": "julds@alerts.julds.com",
    "SANDBOX_ID": "bx_2jd5dd8b",
    "VMS": "julds:bx_2jd5dd8b,icb:bx_f6weypz2,investor-os:bx_v995m7qg,coworkers:bx_9kqsfscv,erivault:bx_4yh2ns5a,altschool:bx_daewc545",
    "KEEP_WEEKLY": "4",
    "ACCESS_TEAM": "julds",
    "ACCESS_AUD": "a58dcb77b7b1abccaa4abcb095aaa29c1b2d651e87a385fd27dc1bd0490d6e99",
    "ALLOWED_EMAILS": "work@somtougeh.com,smugeh@gmail.com",
    "T3_RELAY_URL": "https://prod-30d01c3c481664ad.t3coderelay.com/.well-known/t3/environment"
  }
}
