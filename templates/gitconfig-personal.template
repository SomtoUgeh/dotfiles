# Personal GitHub identity (SomtoUgeh). Active under ~/code/personal/,
# ~/code/TalentQL/ and the agent worktree dirs, via includeIf in git/.gitconfig.
#
#   cp templates/gitconfig-personal.template ~/.gitconfig-personal
#
# Private key is held in the 1Password Personal vault and served by the
# 1Password SSH agent. signingkey points at the PUBLIC key on disk.

[user]
	name = Somto Odera
	email = smugeh@gmail.com
	signingkey = ~/.ssh/somto_sign_ed25519.pub

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.ssh/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgSign = true

[core]
	sshCommand = ssh -i ~/.ssh/somto_auth_ed25519.pub -o IdentitiesOnly=yes

[url "git@github-personal:"]
	insteadOf = https://github.com/
	insteadOf = git@github.com:
