# OrbStack requires this include before every Host block. OpenSSH ignores it
# when OrbStack is not installed, so the same template works on a new Mac.
Include ~/.orbstack/ssh/config

# ~/.ssh/config
#
# Private keys live in the 1Password vault and are served by the 1Password SSH
# agent. Only PUBLIC keys exist in this directory; IdentityFile points at a
# .pub so ssh knows which agent identity to offer per host.
#
# github.com uses the personal account (SomtoUgeh). The personal gitconfig
# rewrites GitHub URLs onto the github-personal alias; that alias offers the
# same key.

Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Personal account - SomtoUgeh
Host github.com github-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/somto_auth_ed25519.pub
    IdentitiesOnly yes


# boat project VMs over Tailscale (tailnet taildbdfb2). Each VM has this Mac key in
# ~/.ssh/authorized_keys. Zed's ssh_connections use these names (config/zed/settings.json).
Host julds altschool icb investor-os coworkers erivault
    HostName %h.taildbdfb2.ts.net
    User user
    IdentityFile ~/.ssh/somto_auth_ed25519.pub
    IdentitiesOnly yes
    ServerAliveInterval 30

# Fallback when a VM's Tailscale is broken after a boat restore: boat's own SSH endpoint,
# looked up on each connect (it changes on every resume). Needs scripts/boat/boat-ssh-proxy
# in ~/.local/bin. Example: ssh coworkers-boat
Host coworkers-boat
    ProxyCommand ~/.local/bin/boat-ssh-proxy bx_9kqsfscv
    HostKeyAlias boat-coworkers
    User user
    IdentityFile ~/.ssh/somto_auth_ed25519.pub
    IdentitiesOnly yes

Host erivault-boat
    ProxyCommand ~/.local/bin/boat-ssh-proxy bx_4yh2ns5a
    HostKeyAlias boat-erivault
    User user
    IdentityFile ~/.ssh/somto_auth_ed25519.pub
    IdentitiesOnly yes
