# OrbStack requires this include before every Host block. OpenSSH ignores it
# when OrbStack is not installed, so the same template works on a new Mac.
Include ~/.orbstack/ssh/config

# ~/.ssh/config
#
# Private keys live in the 1Password vault and are served by the 1Password SSH
# agent. Only PUBLIC keys exist in this directory; IdentityFile points at a
# .pub so ssh knows which agent identity to offer per host.
#
# Work is the default for github.com. Personal repos go through the
# github-personal alias, which the personal gitconfig rewrites URLs to
# automatically, so you rarely type it.

Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Work account (default) - somto-swissblock
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/swissblock_auth_ed25519.pub
    IdentitiesOnly yes

# Personal account - SomtoUgeh
Host github-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/somto_auth_ed25519.pub
    IdentitiesOnly yes

# Private AltSchool development VM through Cloudflare One. Use the plain alias
# for shells and file copies; use the tunnel alias for local web ports.
Host altschool altschool-tunnel
    HostName 10.106.0.2
    User altschool
    IdentityFile ~/.ssh/altschool_vm_rsa.pub
    IdentitiesOnly yes
    ForwardAgent no
    ServerAliveInterval 60
    ServerAliveCountMax 3
    SendEnv COLORTERM TERM_PROGRAM

Host altschool-tunnel
    ExitOnForwardFailure yes
    LocalForward 127.0.0.1:3000 127.0.0.1:3000
    LocalForward 127.0.0.1:5173 127.0.0.1:5173
    LocalForward 127.0.0.1:8080 127.0.0.1:8080
