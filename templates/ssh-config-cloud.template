# Cloud worker only. NOT the Mac.
#
#   cp templates/ssh-config-cloud.template ~/.ssh/config
#
# The cloud worker has no 1Password agent, so its key is an ordinary private
# key FILE (~/.ssh/id_ed25519_personal) - deliberately a different key from the
# Mac's vault-held somto_auth_ed25519. It must be registered on GitHub in its
# own right; the Mac's keys will not work here.
#
# Personal account only.

Host github.com github-personal
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_personal
  IdentitiesOnly yes

# T3 device host: the Mac, through the boat reverse tunnel (Mac :22 -> VM 127.0.0.1:2222)
# kept up by the Mac's julds-executor-bridge. Used by T3 Settings > Integrations >
# Devices > Device hosts for iOS Simulators. Key: ssh-keygen -t ed25519 -N "" -f ~/.ssh/t3_device_host,
# public half in the Mac's ~/.ssh/authorized_keys with from="127.0.0.1,::1".
# See docs/boat-t3-workspace.md, "iOS Simulators".
Host mac-devices
  HostName 127.0.0.1
  Port 2222
  User somto
  IdentityFile ~/.ssh/t3_device_host
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  ServerAliveInterval 30
