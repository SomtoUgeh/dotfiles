# Which vaults the 1Password SSH agent serves keys from.
#
#   mkdir -p ~/.config/1Password/ssh
#   cp templates/1password-agent.toml.template ~/.config/1Password/ssh/agent.toml
#
# Without this file the agent exposes only a default subset - the Swissblock
# vault was excluded, so op-ssh-sign reported
#   'No SSH private key found for the specified public key'.
#
# Vault-scoped on purpose: keys added later are served without editing this.
# NOTE: 1Password's Settings > Developer > SSH agent > 'Edit automatically'
# button may OVERWRITE this file with item-scoped entries. Check it after.

[[ssh-keys]]
vault = "Personal"

[[ssh-keys]]
vault = "Swissblock"
