<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rendered by install.sh to ~/Library/LaunchAgents/com.somto.worm-guard-watch.plist

  Runs scripts/watch_remotes.sh every 4 hours. It answers the one question
  scan_repo.sh structurally cannot: "did anyone force push to my remotes".
  The attack it watches for never touches this disk, so no local scanner and
  no git hook can see it.

  launchd does not source your shell, so PATH is set explicitly. gh reads its
  token from the login keychain, which is available while you are logged in —
  this is a LaunchAgent, not a LaunchDaemon, for exactly that reason.

  Load:    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.somto.worm-guard-watch.plist
  Unload:  launchctl bootout   gui/$(id -u)/com.somto.worm-guard-watch
  Status:  launchctl print     gui/$(id -u)/com.somto.worm-guard-watch | head -20
  Run now: launchctl kickstart -p gui/$(id -u)/com.somto.worm-guard-watch
  Log:     ~/.local/state/worm-guard/watch.log

  Findings exit 1 and post a macOS notification. The log is the record; read it
  after any notification, because the notification does not say which repo.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.somto.worm-guard-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/code/personal/dotfiles/scripts/watch_remotes.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <!-- Every 4 hours. The observed attack came in batches 31 hours apart,
         at 21:19 and 04:16 UTC, so a daily run could miss a whole day of
         exposure. Raise this if the API calls ever become a nuisance. -->
    <key>StartInterval</key>
    <integer>14400</integer>

    <!-- Catch up after a reboot or after the laptop was closed for a while. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/worm-guard/watch.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/worm-guard/watch.log</string>

    <!-- Read-only work over the network. Never let it wake a sleeping Mac. -->
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
