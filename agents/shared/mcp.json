{
  "servers": {
    "executor": {
      "type": "stdio",
      "command": "executor",
      "args": [
        "mcp",
        "--elicitation-mode",
        "browser",
        "--no-artifacts"
      ]
    },
    "figma-remote-mcp": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp-eu.posthog.com/mcp"
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp"
    }
  }
}
