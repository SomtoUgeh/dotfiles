{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "model": "xai/grok-4.6",
  "skills": {
    "paths": ["~/code/personal/dotfiles/agents/skills"],
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true,
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@4.19.1", "mcp"],
      "enabled": true,
    },
  },
  "permission": {
    "*": "allow",
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "question": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "task": {
      "*": "allow",
    },
    "external_directory": "allow",
    "doom_loop": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.config/agent-secrets/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.grok/auth.json": "deny",
      "~/.local/share/opencode/auth.json": "deny",
    },
  },
}
