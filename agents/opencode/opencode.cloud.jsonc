{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "model": "xai/grok-4.6",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
      },
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp",
        "oauth": false,
      },
      "shadcn": {
        "type": "local",
        "command": ["npx", "-y", "shadcn@4.19.1", "mcp"],
      },
    },
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "~/.config/agent-secrets/**", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gh/**", "effect": "deny" },
    { "action": "read", "resource": "~/.grok/auth.json", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/opencode/auth.json", "effect": "deny" },
  ],
}
