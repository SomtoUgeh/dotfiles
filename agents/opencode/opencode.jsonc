{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "mcp": {
    "servers": {
      "executor_v2": {
        "type": "remote",
        "url": "https://executor-v2.julds.com/mcp?elicitation_mode=browser",
      },
      "executor_v2_local": {
        "type": "remote",
        "url": "http://127.0.0.1:4312/mcp?elicitation_mode=browser",
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
        },
      },
      "posthog": {
        "type": "remote",
        "url": "https://mcp-eu.posthog.com/mcp",
        "disabled": true,
      },
      "agentation": {
        "type": "local",
        "command": ["npx", "-y", "agentation-mcp", "server"],
      },
      "shadcn": {
        "type": "local",
        "command": ["npx", "-y", "shadcn@latest", "mcp"],
      },
      "paper": {
        "type": "remote",
        "url": "http://127.0.0.1:29979/mcp",
        "disabled": true,
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
      },
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp",
      },
      "cloudflare-bindings": {
        "type": "remote",
        "url": "https://bindings.mcp.cloudflare.com/mcp",
      },
      "cloudflare-builds": {
        "type": "remote",
        "url": "https://builds.mcp.cloudflare.com/mcp",
      },
      "cloudflare-observability": {
        "type": "remote",
        "url": "https://observability.mcp.cloudflare.com/mcp",
      },
    },
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "cloudflare*", "resource": "*", "effect": "ask" },
    { "action": "cloudflare-docs_*", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
  ],
}
