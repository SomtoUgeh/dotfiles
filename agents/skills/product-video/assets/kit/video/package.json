{
  "name": "product-video",
  "version": "1.0.0",
  "description": "Script-driven product video edit: Remotion compositions, voiceover tool and checks",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "mediabunny": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "lint": "eslint src && tsc",
    "clips": "node scripts/sync-clips.mjs",
    "beats": "node scripts/beats.mjs",
    "voiceover": "node scripts/voiceover.mjs",
    "timeline": "remotion compositions --log=verbose 2>&1 | node scripts/timeline-report.mjs",
    "render": "node scripts/render.mjs",
    "check": "node scripts/final-check.mjs",
    "sheet": "node scripts/contact-sheet.mjs",
    "test": "node --test \"scripts/lib/*.test.mjs\""
  },
  "allowScripts": {
    "esbuild": false
  }
}
