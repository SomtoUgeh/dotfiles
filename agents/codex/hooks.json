{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${DOTFILES_DIR}/agents/shared/hooks/git_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.agents/skills/shaping/shaping-ripple.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
